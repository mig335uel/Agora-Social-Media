package com.antihodio.agora

import android.content.Context
import android.security.keystore.KeyGenParameterSpec
import android.security.keystore.KeyProperties
import android.util.Base64
import java.security.KeyStore
import javax.crypto.Cipher
import javax.crypto.KeyGenerator
import javax.crypto.SecretKey
import javax.crypto.spec.GCMParameterSpec
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import kotlinx.coroutines.suspendCancellableCoroutine
import okhttp3.*
import java.security.KeyPairGenerator
import com.google.android.play.core.integrity.IntegrityManagerFactory
import com.google.android.play.core.integrity.IntegrityTokenRequest
import kotlin.coroutines.resume
import android.util.Log


object AgoraKeyManager {
    private const val ALIAS_MAESTRO = "AgoraMasterKey"
    private const val PREFS_NAME = "AgoraBunkerPrefs"
    private const val KEY_CIPHERTEXT = "encrypted_publishable"
    private const val KEY_IV = "encryption_iv" // Vector de inicialización (Vital para GCM)

    // 1. OBTENER O CREAR LA LLAVE MAESTRA (Nunca sale del TEE)
    private fun getMasterKey(): SecretKey {
        val keyStore = KeyStore.getInstance("AndroidKeyStore").apply { load(null) }

        if (!keyStore.containsAlias(ALIAS_MAESTRO)) {
            val keyGenerator =
                    KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore")
            val spec =
                    KeyGenParameterSpec.Builder(
                                    ALIAS_MAESTRO,
                                    KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT
                            )
                            .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
                            .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
                            // Opcional pero recomendado: requerir autenticación del usuario
                            // (biometría)
                            // .setUserAuthenticationRequired(true)
                            .build()
            keyGenerator.init(spec)
            keyGenerator.generateKey()
        }
        return keyStore.getKey(ALIAS_MAESTRO, null) as SecretKey
    }

    fun generarYObtenerClavePublica(): String {
        val alias = "AgoraIdentityKey"
        val keyStore = KeyStore.getInstance("AndroidKeyStore").apply { load(null) }

        // Si no existe, el TEE la crea (Hardware-bound)
        if (!keyStore.containsAlias(alias)) {
            val kpg =
                    KeyPairGenerator.getInstance(KeyProperties.KEY_ALGORITHM_RSA, "AndroidKeyStore")
            kpg.initialize(
                    KeyGenParameterSpec.Builder(alias, KeyProperties.PURPOSE_DECRYPT)
                            .setDigests(KeyProperties.DIGEST_SHA256)
                            .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_RSA_OAEP)
                            .setKeySize(2048)
                            .build()
            )
            kpg.generateKeyPair()
        }

        // Sacamos los bytes y los pasamos a Base64 limpio para el Header
        val publicKey = keyStore.getCertificate(alias).publicKey
        return Base64.encodeToString(publicKey.encoded, Base64.NO_WRAP)
    }

    suspend fun inicializarBunker(context: Context) =
            withContext(Dispatchers.IO) {
                try {
                    // --- PRE-CHECK: ¿Ya tenemos la clave guardada? ---
                    val claveExistente = extraerClaveDelBunker(context)
                    if (!claveExistente.isNullOrEmpty()) {
                        Log.i("Bunker", "La llave ya está blindada en el TEE. Saltando verificación de red.")
                        return@withContext
                    }

                    // 1. GENERAR / SACAR LA CLAVE PÚBLICA DEL TEE
                    // Esta es la que el servidor usará como "molde" para cifrar
                    val publicKeyString = generarYObtenerClavePublica()

                    // 2. OBTENER EL TOKEN DE PLAY INTEGRITY
                    val projectNumber = 948102256648L // <- Proyecto Agora
                    val integrityToken = obtenerTokenIntegridad(context, projectNumber)

                    if (integrityToken == null) {
                        Log.e("Bunker", "Fallo de integridad. Abortando.")
                        return@withContext
                    }

                    // 3. LA LLAMADA AL SERVIDOR (NETLIFY)
                    val client = OkHttpClient()
                    val request =
                            Request.Builder()
                                    .url("https://api.periodiconaranja.es/agoras/skadjgflasdfjkasdlf")
                                    .get()
                                    .addHeader("x-platform", "android")
                                    .addHeader("x-play-integrity-token", integrityToken)
                                    .addHeader("x-agora-publickey", publicKeyString)
                                    .build()

                    val response = client.newCall(request).execute()

                    if (response.isSuccessful) {
                        val jweCifrado = response.body?.string()
                        if (jweCifrado != null) {
                            // 4. EL ENTIERRO
                            blindarClave(context, jweCifrado)
                            Log.i("Bunker", "¡Sistema blindado con éxito!")
                        }
                    } else {
                        Log.e("Bunker", "Servidor denegó acceso: ${response.code}")
                    }
                } catch (e: Exception) {
                    Log.e("Bunker", "Error crítico en el búnker: ${e.message}")
                }
            }

    // EL ENTIERRO: Recibe la clave desde C++, la encripta en el TEE y la guarda
    fun blindarClave(context: Context, claveLimpia: String) {
        try {
            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
            cipher.init(Cipher.ENCRYPT_MODE, getMasterKey())

            val iv = cipher.iv // El hardware genera un IV único
            val ciphertext = cipher.doFinal(claveLimpia.toByteArray(Charsets.UTF_8))

            // Guardamos el texto cifrado y el IV en Base64 en las SharedPreferences
            val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
            prefs.edit()
                    .putString(KEY_IV, Base64.encodeToString(iv, Base64.DEFAULT))
                    .putString(KEY_CIPHERTEXT, Base64.encodeToString(ciphertext, Base64.DEFAULT))
                    .apply()
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    // LA EXTRACCIÓN: El interceptor llama a esto para obtener la clave al vuelo
    fun extraerClaveDelBunker(context: Context): String? {
        val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
        val ivBase64 = prefs.getString(KEY_IV, null) ?: return null
        val ciphertextBase64 = prefs.getString(KEY_CIPHERTEXT, null) ?: return null

        return try {
            val iv = Base64.decode(ivBase64, Base64.DEFAULT)
            val ciphertext = Base64.decode(ciphertextBase64, Base64.DEFAULT)

            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
            val spec = GCMParameterSpec(128, iv)
            cipher.init(Cipher.DECRYPT_MODE, getMasterKey(), spec)

            val decryptedBytes = cipher.doFinal(ciphertext)
            String(decryptedBytes, Charsets.UTF_8)
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }

    private suspend fun obtenerTokenIntegridad(context: Context, projectNumber: Long): String? = suspendCancellableCoroutine { continuation ->
        // Si detectamos debug, saltamos Play Integrity para facilitar desarrollo
        // Pero el servidor seguirá bloqueándolo si no está en modo development
        try {
            val integrityManager = IntegrityManagerFactory.create(context)
            val nonce = (1..32).map { "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".random() }.joinToString("")
            
            val request = IntegrityTokenRequest.builder()
                .setCloudProjectNumber(projectNumber)
                .setNonce(nonce)
                .build()
                
            integrityManager.requestIntegrityToken(request)
                .addOnSuccessListener { response ->
                    continuation.resume(response.token())
                }
                .addOnFailureListener { e ->
                    Log.e("Bunker", "Error solicitando integridad: ${e.message}")
                    continuation.resume(null)
                }
        } catch (e: Exception) {
            Log.e("Bunker", "Error en Integrity: ${e.message}")
            continuation.resume(null)
        }
    }
}
