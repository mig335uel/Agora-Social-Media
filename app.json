{
  "expo": {
    "name": "agora",
    "slug": "agora",
    "scheme": "agora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AgorasFinalLogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/AgorasFinalLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/AgorasLogo.png",
      "color": "#FC0000",
      "iosDisplayInForeground": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antihodio.agora",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Agora necesita acceder a tus fotos para que puedas compartir imágenes en tus posts.",
        "NSPhotoLibraryAddUsageDescription": "Agora necesita permiso para guardar imágenes editadas en tu carrete.",
        "NSCameraUsageDescription": "Agora necesita usar la cámara si quieres tomar fotos directamente para tus posts."

      }

    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/AgorasAndroidLogo.png",
        "backgroundImage": "./assets/AgorasAndroidLogo.png",
        "monochromeImage": "./assets/AgorasAndroidLogo.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_INTERNAL_STORAGE",
        "android.permission.WRITE_INTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.antihodio.agora"
    },
    "web": {
      "favicon": "./assets/AgorasLogo.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-notifications",
      "@react-native-community/datetimepicker",
     [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "extraPods": [
              { "name": "FirebaseCore", "modular_headers": true }
            ]
          }
        }
      ]
    ]
  }
}
