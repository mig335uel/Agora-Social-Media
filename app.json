{
  "expo": {
    "name": "agora",
    "slug": "agora",
    "scheme": "agora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AgorasFinalLogo.png",
    "extra": {
      "eas": {
        "projectId": "5daba5d2-4908-419a-9034-2e3ea691e59f"
      }
    },
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/AgorasFinalLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/AgorasLogo.png",
      "color": "#FC0000",
      "iosDisplayInForeground": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antihodio.agora",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Agora necesita acceder a tus fotos para que puedas compartir imágenes en tus posts.",
        "NSPhotoLibraryAddUsageDescription": "Agora necesita permiso para guardar imágenes editadas en tu carrete.",
        "NSCameraUsageDescription": "Agora necesita usar la cámara si quieres tomar fotos directamente para tus posts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/AgorasAndroidLogo.png",
        "backgroundImage": "./assets/AgorasAndroidLogo.png",
        "monochromeImage": "./assets/AgorasAndroidLogo.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_INTERNAL_STORAGE",
        "android.permission.WRITE_INTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.antihodio.agora",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/AgorasLogo.png"
    },
    "plugins": [
      "./plugins/withBunker.js",
      "expo-sqlite",
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "buildReactNativeFromSource": false,
            "extraPods": [
              {
                "name": "FirebaseCore",
                "modular_headers": true
              }
            ],
            "release": {
              "deadCodeStripping": true,
              "stripDebugSymbolsDuringCopy": true,
              "optimizationLevel": "s"
            }
          },
          "android": {
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class javax.crypto.** { *; }\n-keep class java.security.** { *; }\n-keep class com.antihodio.agora.interceptors.** { *; }\n-keepattributes Signature, *Annotation*, EnclosingMethod\n-keep class okhttp3.** { *; }\n-dontwarn okhttp3.**"
          }
        }
      ],
      "expo-font"
    ]
  }
}